# Copy to .streamlit/secrets.toml (git-ignored) and fill in the two keys.
# On Streamlit Cloud paste the same block into Settings -> Secrets.

[aws]
region            = "us-east-1"
bucket            = "permanent-data-bucket"

# The SKU list the FH_New_SKU_Checker Lambda reads.
sku_key           = "inputs/fasthouse/sku-available/SKUS.txt"
sku_prefix        = "inputs/fasthouse/"

# Previous versions are copied here before the list is overwritten.
# Deliberately OUTSIDE sku-available/ so a backup can never be picked up
# as input by the Lambda.
backup_prefix     = "inputs/fasthouse/sku-backups/"

# Where crawled images are published for Amazon to fetch.
images_bucket     = "fasthouse-listing-images"
images_prefix     = ""
# Override only if you put a CDN in front of the bucket.
images_public_base = ""

lambda_arn        = "arn:aws:lambda:us-east-1:065614340143:function:FH_New_SKU_Checker"

# Optional: if the checker writes its output somewhere, point at it and the
# newest files are listed in the app. Leave blank if it does not.
results_prefix    = ""

# Optional: JSON the Lambda expects, if it does not just read sku_key.
# lambda_payload  = { source = "streamlit" }

# IAM user with s3:GetObject/PutObject on sku_key and backup_prefix,
# s3:ListBucket on the bucket, and lambda:InvokeFunction on the function.
access_key_id     = ""
secret_access_key = ""
