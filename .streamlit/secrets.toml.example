# Copy to .streamlit/secrets.toml (git-ignored) and fill in.
# On Streamlit Cloud paste the same block into Settings -> Secrets.

[aws]
region            = "us-east-1"
bucket            = "permanent-data-bucket"

# Exact key of the SKU list the checker Lambda reads.
# Leave blank to browse for it in the app, then paste the key here.
sku_key           = ""
sku_prefix        = "inputs/"

lambda_arn        = "arn:aws:lambda:us-east-1:065614340143:function:FH_New_SKU_Checker"

# Optional: where the checker writes its output, shown in the app.
results_prefix    = "sku-available/"

# IAM user with s3:GetObject/PutObject on the SKU key + its backups/ folder,
# s3:ListBucket on the bucket, and lambda:InvokeFunction on the function.
access_key_id     = ""
secret_access_key = ""
